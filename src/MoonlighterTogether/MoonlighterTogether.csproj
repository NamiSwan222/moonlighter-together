<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MoonlighterTogether</AssemblyName>
    <RootNamespace>MoonlighterTogether</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Folder of a Moonlighter 1.15.8 install that has BepInEx 5 in it. Override: dotnet build -p:GamePath=... -->
    <GamePath Condition="'$(GamePath)' == ''">$(MSBuildThisFileDirectory)..\..\testgame</GamePath>
    <Managed>$(GamePath)\Moonlighter_Data\Managed</Managed>
    <NoWarn>$(NoWarn);CS0436;CS0618;CS0169;CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    <PackageReference Include="LiteNetLib" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp" Publicize="true"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true"><HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(Managed)\UnityEngine.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\UnityEngine.*.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\DOTween.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Newtonsoft.Json.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\TextMeshPro-2017.3-Runtime.dll"><Private>false</Private></Reference>
  </ItemGroup>
  <!-- Copy the plugin and its one library next to each other into the test game's plugin folder. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx') And '$(DeployToGame)' != 'false'">
    <ItemGroup>
      <DeployFiles Include="$(OutDir)MoonlighterTogether.dll;$(OutDir)MoonlighterTogether.pdb;$(OutDir)LiteNetLib.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(GamePath)\BepInEx\plugins\MoonlighterTogether" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>
</Project>
